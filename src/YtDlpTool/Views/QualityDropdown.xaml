<UserControl x:Class="YtDlpTool.Views.QualityDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Items are Domain.Services.QualityChoice; ToString() is the label, so the combo
         and screen readers both show e.g. 「1080p · 約 105 MB」. -->
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="QualityLabel" Text="畫質" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
        <ComboBox x:Name="QualityCombo" Width="230" Height="40"
                  AutomationProperties.Name="畫質"
                  SelectionChanged="OnSelectionChanged" />
        <!-- v1.5.0: in the dropdown's place (not next to it): beside it the row was ~776 px
             wide at the 780 px minimum window and pushed 下載 off the card. -->
        <TextBlock x:Name="NoFormatsText" Text="此影片沒有可用的格式" Width="230"
                   Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}"
                   VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
