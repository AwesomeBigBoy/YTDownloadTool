<UserControl x:Class="YtDlpTool.Views.UrlInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="UrlTextBox"
                         Height="40" FontSize="14" Padding="36,0,36,0"
                         AutomationProperties.Name="YouTube 網址"
                         TextChanged="OnTextChanged"
                         KeyDown="OnKeyDown" />
                <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="Placeholder" Text="{StaticResource Url.Placeholder}"
                           Foreground="{StaticResource Brush.TextTertiary}" FontSize="14"
                           VerticalAlignment="Center" Margin="38,0,40,0"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                <Button x:Name="ClearButton" Style="{StaticResource Button.Icon}"
                        Content="&#xE711;" FontSize="10" Width="28" Height="28"
                        HorizontalAlignment="Right" Margin="0,0,6,0"
                        ToolTip="清除" AutomationProperties.Name="清除網址"
                        Visibility="Collapsed" Click="OnClearClicked" />
            </Grid>

            <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource Button.Secondary}"
                    Height="40" Margin="8,0,0,0"
                    ToolTip="貼上剪貼簿中的網址（Ctrl+V）" AutomationProperties.Name="貼上"
                    Click="OnPasteClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77F;" Style="{StaticResource Text.Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="{StaticResource Url.PasteButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- While a URL is being read. The bar's pulse only runs while IsIndeterminate is
             true; code-behind clears it whenever the panel is hidden. -->
        <StackPanel x:Name="ParsingPanel" Margin="2,12,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="ParsingBar" Height="3" IsIndeterminate="False" />
            <TextBlock x:Name="ParsingCaption" Text="{StaticResource Url.Parsing}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
            <!-- v1.3.7: shown while the once-per-launch yt-dlp cold start is still running,
                 so a slow first extraction reads as "please wait" rather than a stall. -->
            <TextBlock x:Name="WarmupHint" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- v1.3.6: TextWrapping is REQUIRED. ErrorMapper's messages (E-TIMEOUT02 is ~250
             chars of remediation steps) otherwise run off the card and users only see
             the first words. Do not remove. -->
        <Border x:Name="ErrorPanel" Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                Background="{StaticResource Brush.DangerSurface}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}"
                           Foreground="{StaticResource Brush.Danger}"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock x:Name="ErrorLabel" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Danger}"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
