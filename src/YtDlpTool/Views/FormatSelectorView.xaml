<UserControl x:Class="YtDlpTool.Views.FormatSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- v1.5.0: a segmented control made of RadioButtons (keyboard arrows + screen
         readers for free). 影片 = AudioAndVideo (the common case, first), 音訊 =
         AudioOnly, 無聲影片 = VideoOnly. -->
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="格式" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
        <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="3" Height="40">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="格式">
                <RadioButton x:Name="BothBtn" Tag="AudioAndVideo" Content="影片"
                             Style="{StaticResource RadioButton.Segment}"
                             ToolTip="影像與聲音，存成 MP4" Checked="OnModeChecked" />
                <RadioButton x:Name="AudioBtn" Tag="AudioOnly" Content="音訊"
                             Style="{StaticResource RadioButton.Segment}"
                             ToolTip="只有聲音，存成 M4A 或 MP3" Checked="OnModeChecked" />
                <RadioButton x:Name="VideoBtn" Tag="VideoOnly" Content="無聲影片"
                             Style="{StaticResource RadioButton.Segment}"
                             ToolTip="只有畫面，沒有聲音" Checked="OnModeChecked" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
