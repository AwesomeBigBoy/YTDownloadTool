<UserControl x:Class="YtDlpTool.Views.HealthBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
    <Border Background="{StaticResource Brush.DangerSurface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" CornerRadius="10" Padding="14,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.Danger}" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" />
                <!-- v1.5.0: one-click repair status (AppHost.RepairYtDlpAsync). Collapsed when there
                     is nothing to say, so the headline stays vertically centred. -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding ShowRepairStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding RepairStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <!-- v1.5.0: the dark grey track all but vanished on the red banner. -->
                    <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100" Value="{Binding RepairPercent}"
                                 Background="#40FF7A7A" Foreground="{StaticResource Brush.Danger}"
                                 Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="RepairButton" Grid.Column="2" Content="修復" Style="{StaticResource Button.Primary}"
                    Height="30" FontSize="13" Padding="16,0" Margin="12,0,4,0"
                    ToolTip="重新下載並驗證 yt-dlp 元件（約 24 MB）後立即換上"
                    Visibility="{Binding ShowRepairButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="OnRepairClicked" />
            <Button Grid.Column="3" Content="詳細說明" Style="{StaticResource Button.Secondary}" Height="30"
                    Margin="4,0,4,0" Click="OnDetailsClicked" />
            <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10"
                    Width="30" Height="30" ToolTip="關閉" AutomationProperties.Name="關閉提示"
                    Click="OnDismissClicked" />
        </Grid>
    </Border>
</UserControl>
