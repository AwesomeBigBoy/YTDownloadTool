<UserControl x:Class="YtDlpTool.Views.AdvancedOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:YtDlpTool.Controls">
    <Expander x:Name="ExpanderRoot" Style="{StaticResource Expander.Disclosure}"
              AutomationProperties.Name="{StaticResource Advanced.Title}"
              AutomationProperties.HelpText="{StaticResource Advanced.Hint}">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Advanced.Title}" VerticalAlignment="Center" />
                <TextBlock Text="{StaticResource Advanced.Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextTertiary}" FontSize="12" />
            </StackPanel>
        </Expander.Header>

        <StackPanel>
            <!-- Subtitles: up to 3, muxed into the video. Not offered in 音訊 mode, where
                 the pipeline never embeds them (YtDlpDownloadExecutor.hasSubs). -->
            <StackPanel x:Name="SubtitleSection" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="{StaticResource Advanced.SubtitlesLabel}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                <ItemsControl x:Name="SubtitlesList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <TextBlock x:Name="NoSubtitlesText" Style="{StaticResource Text.Label}" Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ClipEnabled" Content="{StaticResource Advanced.ClipLabel}" VerticalAlignment="Center"
                          Checked="OnClipToggle" Unchecked="OnClipToggle" />
                <ctrl:MaskedTimeTextBox x:Name="ClipStart" Width="96" Margin="14,0,0,0" Text="00:00:00"
                                        AutomationProperties.Name="{StaticResource Advanced.ClipStart}"
                                        TextChanged="OnClipChanged" IsEnabled="False" />
                <TextBlock Text="到" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                <ctrl:MaskedTimeTextBox x:Name="ClipEnd" Width="96" Text="00:01:00"
                                        AutomationProperties.Name="{StaticResource Advanced.ClipEnd}"
                                        TextChanged="OnClipChanged" IsEnabled="False" />
                <TextBlock Text="{StaticResource Advanced.ClipFormatHint}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ClipError" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}" Visibility="Collapsed" />
        </StackPanel>
    </Expander>
</UserControl>
