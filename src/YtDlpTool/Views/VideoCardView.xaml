<UserControl x:Class="YtDlpTool.Views.VideoCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The parsed video. Bound to MainViewModel.CurrentMetadata / CurrentThumbnail /
         MetaSubtitle; the card is shown by MainWindow's DetailsPanel (HasMetadata). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rounded thumbnail: an ImageBrush on a Border is clipped by its CornerRadius,
             an Image inside one would not be. The plain Border underneath is the
             placeholder while the image loads (or when it cannot). -->
        <Grid Width="160" Height="90">
            <Border CornerRadius="8" Background="{StaticResource Brush.SurfaceAlt}" />
            <Border CornerRadius="8" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding CurrentThumbnail}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="MetaTitle" Text="{Binding CurrentMetadata.Title}"
                       Style="{StaticResource Text.Title}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44"
                       ToolTip="{Binding CurrentMetadata.Title}" />
            <TextBlock Text="{Binding MetaSubtitle}" Style="{StaticResource Text.Caption}"
                       FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            <!-- v1.5.0: the link came from a playlist (watch?v=…&list=…). -->
            <Button Content="這部影片在播放清單中 · 選擇清單裡的影片…" Style="{StaticResource Button.Link}"
                    HorizontalAlignment="Left" Margin="-4,6,0,0" AutomationProperties.Name="選擇播放清單裡的影片"
                    Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="OnPlaylistClicked" />
        </StackPanel>
    </Grid>
</UserControl>
