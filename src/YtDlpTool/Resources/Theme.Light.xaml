<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colours · Vivid Sunrise palette (light variant) — saturated and bright -->
    <Color x:Key="Color.Accent">#FF5A7E</Color>           <!-- hot coral pink, more energetic than #FF6B6B -->
    <Color x:Key="Color.AccentHover">#E63D63</Color>
    <Color x:Key="Color.Danger">#E63946</Color>
    <Color x:Key="Color.Success">#28D89B</Color>          <!-- vivid mint -->
    <Color x:Key="Color.TextPrimary">#1A1D2E</Color>      <!-- full-opacity deep navy for max contrast on bright bg -->
    <Color x:Key="Color.TextSecondary">#995A6080</Color>  <!-- 60% slate -->
    <Color x:Key="Color.TextTertiary">#665A6080</Color>   <!-- 40% slate -->
    <!-- 60% white was too prominent on the saturated Aurora gradient — every
         GlassCard looked wrapped in white tape (user-reported, screenshot 2026-05-15).
         10% gives the same "glass rim" hint without the hard outline. -->
    <Color x:Key="Color.GlassBorder">#1AFFFFFF</Color>    <!-- 10% white -->
    <!-- 88% white was the original "crisp cards over bright gradient" tuning,
         but on the saturated Aurora gradient it produced a stark contrast
         between card and background that the user repeatedly reported as a
         "white border" (v1.1.20 reduced GlassBorder opacity, v1.1.22 zeroed
         BorderThickness, v1.1.25 removed the DropShadowEffect — none removed
         the perceived edge). v1.1.27 drops fill to ~55% so the gradient
         shows through the card and the card-vs-gradient transition becomes
         a soft tint rather than a hard edge. Text contrast is preserved by
         TextPrimary staying at full-opacity deep navy (#1A1D2E). -->
    <Color x:Key="Color.GlassFill">#8CFFFFFF</Color>      <!-- ~55% white -->
    <Color x:Key="Color.AuroraA">#FF5A8F</Color>          <!-- vivid hot pink -->
    <Color x:Key="Color.AuroraB">#FFA940</Color>          <!-- vivid orange-peach -->
    <Color x:Key="Color.AuroraC">#40C8FF</Color>          <!-- vivid sky blue -->

    <!-- Brushes that bind to the colours in THIS dictionary so swapping the dictionary
         swaps both colours and brushes at once (StaticResource lookups in views/Theme.xaml
         resolve through Application.Resources.MergedDictionaries). -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="{StaticResource Color.GlassBorder}" />
    <SolidColorBrush x:Key="Brush.GlassFill"   Color="{StaticResource Color.GlassFill}" />

</ResourceDictionary>
