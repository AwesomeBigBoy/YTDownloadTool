<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colours · Vivid Sunrise palette (light variant) — saturated and bright -->
    <Color x:Key="Color.Accent">#FF5A7E</Color>           <!-- hot coral pink, more energetic than #FF6B6B -->
    <Color x:Key="Color.AccentHover">#E63D63</Color>
    <Color x:Key="Color.Danger">#E63946</Color>
    <Color x:Key="Color.Success">#28D89B</Color>          <!-- vivid mint -->
    <Color x:Key="Color.TextPrimary">#1A1D2E</Color>      <!-- full-opacity deep navy for max contrast on bright bg -->
    <Color x:Key="Color.TextSecondary">#995A6080</Color>  <!-- 60% slate -->
    <Color x:Key="Color.TextTertiary">#665A6080</Color>   <!-- 40% slate -->
    <!-- v1.1.28: restored to v1.1.16 values. Multiple attempts to "fix" the
         user-reported white edge (v1.1.20 opacity, v1.1.22 BorderThickness=0,
         v1.1.25 DropShadow removed, v1.1.27 fill 55%) all made the look
         progressively worse without removing the edge. User decided the
         v1.1.16 visual was preferable, white edge included. -->
    <Color x:Key="Color.GlassBorder">#99FFFFFF</Color>    <!-- 60% white -->
    <Color x:Key="Color.GlassFill">#E0FFFFFF</Color>      <!-- 88% white — crisp cards over bright gradient -->
    <!-- v1.1.29: subtle dark tint for inactive segment buttons / dropdowns so
         they don't disappear into the card body. Calibrated for both themes:
         8% over a light card here, 20% over a dark card in the Dark variant. -->
    <Color x:Key="Color.ButtonSurface">#14000000</Color>  <!-- 8% black -->
    <Color x:Key="Color.AuroraA">#FF5A8F</Color>          <!-- vivid hot pink -->
    <Color x:Key="Color.AuroraB">#FFA940</Color>          <!-- vivid orange-peach -->
    <Color x:Key="Color.AuroraC">#40C8FF</Color>          <!-- vivid sky blue -->

    <!-- Brushes that bind to the colours in THIS dictionary so swapping the dictionary
         swaps both colours and brushes at once (StaticResource lookups in views/Theme.xaml
         resolve through Application.Resources.MergedDictionaries). -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="{StaticResource Color.GlassBorder}" />
    <SolidColorBrush x:Key="Brush.GlassFill"   Color="{StaticResource Color.GlassFill}" />
    <SolidColorBrush x:Key="Brush.ButtonSurface" Color="{StaticResource Color.ButtonSurface}" />

</ResourceDictionary>
