<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- Colours AND brushes live in Theme.Light.xaml / Theme.Dark.xaml.
         ThemeService swaps the entire palette dictionary at runtime; existing StaticResource
         lookups in views resolve through Application.Resources.MergedDictionaries against
         whichever palette dictionary is currently merged. -->

    <!-- Spacing (Thickness so Margin/Padding StaticResource lookups don't break;
         use Space.NValue (Double) for Width/Height/numeric contexts) -->
    <Thickness x:Key="Space.1">4</Thickness>
    <Thickness x:Key="Space.2">8</Thickness>
    <Thickness x:Key="Space.3">12</Thickness>
    <Thickness x:Key="Space.4">16</Thickness>
    <Thickness x:Key="Space.5">24</Thickness>
    <Thickness x:Key="Space.6">32</Thickness>
    <Thickness x:Key="Space.7">48</Thickness>
    <sys:Double x:Key="Space.1Value">4</sys:Double>
    <sys:Double x:Key="Space.2Value">8</sys:Double>
    <sys:Double x:Key="Space.3Value">12</sys:Double>
    <sys:Double x:Key="Space.4Value">16</sys:Double>
    <sys:Double x:Key="Space.5Value">24</sys:Double>
    <sys:Double x:Key="Space.6Value">32</sys:Double>
    <sys:Double x:Key="Space.7Value">48</sys:Double>

    <!-- Typography -->
    <FontFamily x:Key="Font.Default">Microsoft JhengHei UI, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Numeric">Segoe UI Variable, Segoe UI, Consolas</FontFamily>

    <!-- Reusable styles -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
        <!-- v1.1.22: BorderThickness 0 to remove the visible white hairline outline
             on every card. v1.1.20's reduction from 60% → 10% opacity did not
             satisfy the user (still visible on the saturated Aurora gradient).
             The 88%-white GlassFill alone provides plenty of contrast against the
             gradient, and the DropShadowEffect below gives the glass-card depth
             cue. BorderBrush kept on the style for other styles (e.g. dividers)
             that share the same brush via DynamicResource. -->
        <!-- v1.1.28: BorderThickness back to 1 and DropShadowEffect restored.
             v1.1.20 -> v1.1.27 tried multiple removals to address the user-
             reported "white border" but each version looked progressively
             worse without making the edge go away. User asked to revert to
             v1.1.16 visuals (the white edge accepted as an acceptable cost
             of the Aurora Glass aesthetic). -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="{StaticResource Space.5}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="20" ShadowDepth="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="Button">
        <!-- v1.1.29: Background uses Brush.ButtonSurface (theme-aware tint) so
             inactive segment buttons stay readable on the dark theme — the prior
             "Transparent" background made them disappear into the card body. -->
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="48" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button: subtle, with hover/press feedback for small actions like 清除, 瀏覽…, 取消.
         v1.1.31: switched from hardcoded #0D000000 (5% black) to theme-aware
         Brush.ButtonSurface. The 5% black was invisible on dark theme card
         backgrounds (5% black over dark navy = imperceptibly darker dark navy).
         Theme brushes give a visible "chip" on both themes. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="8">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="st" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.ButtonSurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.ButtonSurfacePressed}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="0.96" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="0.96" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LinkButton: text-only with hover underline + colour shift, for 清除, 瀏覽… -->
    <!-- Hover/press tints bumped (#33 / #4D) so the interaction is unmistakable
         vs. the old 10%-accent shimmer. Press additionally scales 0.94 for 80ms,
         eases back to 1 over 120ms — same motion vocabulary as SecondaryButton. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="st" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#33FF5A7E" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#4DFF5A7E" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="0.94" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="0.94" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- IconButton: 32x32 square, transparent, for ⚙ gear -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="st" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1F000000" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="0.94" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="0.94" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DangerIconButton: larger (40x40), used for the queue row ✕. Doubles as remove
         (terminal items) and cancel (active items); hover tints coral so users see
         it's a destructive action rather than the neutral ⚙ pattern. -->
    <Style x:Key="DangerIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="20">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="st" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1AFF5A7E" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#33FF5A7E" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="0.94" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="0.94" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default ComboBox chrome.
         v1.1.29: Background pinned to white + Foreground to dark navy regardless
         of theme. The system-rendered dropdown popup uses an opaque white
         background that WPF default templates do not let us re-skin without a
         full ControlTemplate override. If we let the ComboBox face use
         DynamicResource Brush.TextPrimary (light text in dark theme), the
         items in the popup are then unreadable (light-on-white). Pinning
         both face and items to dark-on-white means the ComboBox always
         looks like a discrete white pill — distinct from the dark card
         background it sits on, and always readable. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#1A1D2E" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#1A1D2E" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- v1.1.28: default CheckBox / TextBox / Expander styles so dark theme actually
         renders readable text. Previously these used WPF's built-in styles which
         use SystemColors.ControlTextBrush — that doesn't track our DynamicResource
         theme palette, so on the dark theme background the labels stayed dark and
         became unreadable (user-reported, 2026-05-16). The setters here are
         minimal — just font, foreground, family — so the WPF default templates
         keep working for the structural bits we don't want to override. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
    </Style>

</ResourceDictionary>
