<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- v1.5.0: trimmed to the keys the dark UI actually uses; wording follows the new
         layout (「下載清單」, 「更多選項」, 格式 影片 / 音訊 / 無聲影片). Code reads
         Url.InvalidNotYouTube through Resources.Strings.Get. -->

    <!-- Window -->
    <sys:String x:Key="App.Name">YtDlpTool</sys:String>

    <!-- URL input -->
    <sys:String x:Key="Url.Placeholder">貼上 YouTube 網址，或按 Ctrl+V</sys:String>
    <sys:String x:Key="Url.PasteButton">貼上</sys:String>
    <sys:String x:Key="Url.Parsing">正在讀取影片資訊…</sys:String>
    <sys:String x:Key="Url.InvalidNotYouTube">這不是 YouTube 網址哦，請確認</sys:String>

    <!-- More options -->
    <sys:String x:Key="Advanced.Title">更多選項</sys:String>
    <sys:String x:Key="Advanced.Hint">字幕、擷取片段</sys:String>
    <sys:String x:Key="Advanced.SubtitlesLabel">字幕（最多 3 種，會嵌入影片）</sys:String>
    <sys:String x:Key="Advanced.ClipLabel">只下載片段</sys:String>
    <sys:String x:Key="Advanced.ClipStart">片段開始時間</sys:String>
    <sys:String x:Key="Advanced.ClipEnd">片段結束時間</sys:String>
    <sys:String x:Key="Advanced.ClipFormatHint">時:分:秒</sys:String>

    <!-- Save location -->
    <sys:String x:Key="Save.Label">儲存到</sys:String>
    <sys:String x:Key="Save.Browse">變更</sys:String>

    <!-- Main button -->
    <sys:String x:Key="Button.AddDownload">下載</sys:String>

    <!-- Download list -->
    <sys:String x:Key="Queue.Title">下載清單</sys:String>

    <!-- Update banner -->
    <sys:String x:Key="Update.OneClick">立即更新</sys:String>
    <sys:String x:Key="Update.Later">稍後</sys:String>

    <!-- Settings -->
    <sys:String x:Key="Settings.Title">設定</sys:String>
    <sys:String x:Key="Settings.SectionDownload">下載</sys:String>
    <sys:String x:Key="Settings.SectionUpdate">更新</sys:String>
    <sys:String x:Key="Settings.SectionAdvanced">進階</sys:String>
    <sys:String x:Key="Settings.DefaultSaveDir">預設儲存資料夾</sys:String>
    <sys:String x:Key="Settings.Concurrency">同時下載數量</sys:String>
    <sys:String x:Key="Settings.CheckFrequency">檢查更新頻率</sys:String>
    <sys:String x:Key="Settings.OpenLogs">開啟紀錄資料夾</sys:String>
    <sys:String x:Key="Settings.About">關於 YtDlpTool</sys:String>

</ResourceDictionary>
