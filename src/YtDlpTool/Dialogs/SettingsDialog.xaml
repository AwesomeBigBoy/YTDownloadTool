<Window x:Class="YtDlpTool.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Settings.Title}"
        Icon="../Resources/app.ico"
        Width="600" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- v1.5.0: removed 語言 (one option), 主題 (dark only), the per-component update
         checkboxes (they gate nothing — 04-update-flow.md) and 開啟下載資料夾 (the main
         window has it). Element names are what SettingsDialog.xaml.cs drives. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20,24,12" Focusable="False">
            <StackPanel>

                <!-- 下載 -->
                <TextBlock Text="{StaticResource Settings.SectionDownload}" Style="{StaticResource Text.Label}" Margin="4,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{StaticResource Settings.DefaultSaveDir}" />
                                <TextBlock x:Name="DefaultDirText" Style="{StaticResource Text.Caption}"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{StaticResource Save.Browse}" Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Center" Click="OnBrowseDefaultDir" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{StaticResource Settings.Concurrency}" />
                                <TextBlock Text="同時進行的下載數量，網路較慢時建議 1–2" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="ConcurrencySlider" Width="160" Minimum="1" Maximum="10"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                                        AutomationProperties.Name="{StaticResource Settings.Concurrency}" />
                                <TextBlock Width="24" Margin="12,0,0,0" TextAlignment="Right" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="{Binding Value, ElementName=ConcurrencySlider, StringFormat=0}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 更新 -->
                <TextBlock Text="{StaticResource Settings.SectionUpdate}" Style="{StaticResource Text.Label}" Margin="4,20,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{StaticResource Settings.CheckFrequency}" />
                                <TextBlock Text="有新版本時，主視窗上方會出現提示" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="FrequencyCombo" Grid.Column="1" Width="150" VerticalAlignment="Center"
                                      AutomationProperties.Name="{StaticResource Settings.CheckFrequency}">
                                <ComboBoxItem Content="每次啟動" Tag="EveryLaunch" />
                                <ComboBoxItem Content="每日"     Tag="Daily" />
                                <ComboBoxItem Content="每週"     Tag="Weekly" />
                                <ComboBoxItem Content="每月"     Tag="Monthly" />
                                <ComboBoxItem Content="不檢查"   Tag="Never" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <StackPanel Margin="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="檢查並更新" />
                                    <TextBlock Text="更新本程式、yt-dlp 與 ffmpeg，每個檔案都會驗證簽章" Style="{StaticResource Text.Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="CheckUpdateNowButton" Grid.Column="1" Content="立即檢查"
                                        Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                                        Click="OnCheckUpdateClicked" />
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <ProgressBar x:Name="UpdateProgressBar" Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" IsIndeterminate="False" />
                            <!-- Fix 2 (v1.1.6): shown when the check fails, opens today's log for an IT report. -->
                            <Button x:Name="OpenDiagnosticsLogLink" Content="顯示診斷詳情" Style="{StaticResource Button.Link}"
                                    HorizontalAlignment="Left" Margin="-8,6,0,0" Visibility="Collapsed"
                                    Click="OnOpenLatestLogClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 進階 -->
                <TextBlock Text="{StaticResource Settings.SectionAdvanced}" Style="{StaticResource Text.Label}" Margin="4,20,0,8" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="紀錄檔" />
                                <TextBlock Text="回報問題時請附上，內容不含網址與影片標題" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{StaticResource Settings.OpenLogs}" Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Center" Click="OnOpenLogs" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <StackPanel Margin="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="重新下載元件" />
                                    <TextBlock Text="yt-dlp 或 ffmpeg 損毀、被防毒移除時使用" Style="{StaticResource Text.Caption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="RedownloadComponentsButton" Grid.Column="1" Content="重新下載"
                                        Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                                        Click="OnRedownloadComponentsClicked" />
                            </Grid>
                            <TextBlock x:Name="RedownloadStatusText" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <ProgressBar x:Name="RedownloadProgressBar" Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" IsIndeterminate="False" />
                            <Button x:Name="OpenDiagnosticsLogLinkAdvanced" Content="顯示診斷詳情" Style="{StaticResource Button.Link}"
                                    HorizontalAlignment="Left" Margin="-8,6,0,0" Visibility="Collapsed"
                                    Click="OnOpenLatestLogClicked" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="根憑證" />
                                <TextBlock Text="檢視從 Windows 匯入給 yt-dlp 使用的根 CA 指紋" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="檢視" Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Center" Click="OnShowCaThumbprintsClicked" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <StackPanel Margin="0,12,0,12">
                            <CheckBox x:Name="AllowUntrustedCertificatesCheckbox" Content="允許不受信任憑證" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Margin="26,6,0,0" FontSize="12" Foreground="{StaticResource Brush.Warning}"
                                       LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                       Text="⚠ 啟用後 YtDlpTool 會接受任何 HTTPS 憑證 — 不檢查發行單位、不檢查金鑰長度、不檢查主機名是否相符。請只在你完全信任當前網路時啟用。連到公共 Wi-Fi（咖啡廳、機場、飯店等）時請關閉，否則他人可能攔截或竄改你下載的內容。變更後程式會自動重新啟動。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="{StaticResource Settings.About}" Style="{StaticResource Button.Link}"
                        HorizontalAlignment="Left" Margin="-4,14,0,0" Click="OnAbout" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Background="{StaticResource Brush.Surface}" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Button.Secondary}" MinWidth="88" IsCancel="True" Click="OnCancel" />
                <Button Content="儲存" Style="{StaticResource Button.Primary}" MinWidth="96" Height="36" Margin="8,0,0,0"
                        Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
