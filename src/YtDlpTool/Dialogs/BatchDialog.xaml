<Window x:Class="YtDlpTool.Dialogs.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YtDlpTool.ViewModels"
        Title="加入多部影片"
        Icon="../Resources/app.ico"
        Width="640" Height="640" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- v1.5.0: the videos of a playlist, or the links of a multi-link paste / drop. The
         ticked ones are parsed and queued one at a time by MainViewModel.AddBatch. -->
    <Window.Resources>
        <!-- A row-wide checkbox: the title column stretches, so long titles trim instead
             of running under the length, and clicking anywhere on the title ticks it. -->
        <Style x:Key="CheckBox.Row" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.SurfaceAlt}"
                                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                                <TextBlock x:Name="check" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12"
                                           Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows highlight under the mouse and under the keyboard cursor; no blue
             selection. ↑↓ move, Space ticks (BatchDialog.OnListKeyDown). -->
        <Style x:Key="ListBoxItem.Batch" TargetType="ListBoxItem">
            <!-- v1.5.0: without these, screen readers read the row as its type name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Detail}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- title -->
            <RowDefinition Height="Auto" />  <!-- count, 全選 / 全不選 -->
            <RowDefinition Height="*" />     <!-- the videos -->
            <RowDefinition Height="Auto" />  <!-- 格式 / 畫質 -->
            <RowDefinition Height="Auto" />  <!-- note -->
            <RowDefinition Height="Auto" />  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Title}" FontSize="16"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="1" Margin="0,6,0,10">
            <TextBlock x:Name="CountText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="全選" Style="{StaticResource Button.Link}" Click="OnSelectAll" />
                <Button Content="全不選" Style="{StaticResource Button.Link}" Margin="12,0,0,0" Click="OnSelectNone" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="10" Padding="4">
            <ListBox x:Name="ItemsList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource ListBoxItem.Batch}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="影片清單"
                     PreviewKeyDown="OnListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BatchItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource CheckBox.Row}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAvailable}"
                                      AutomationProperties.Name="{Binding Title}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" />
                            </CheckBox>
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Text.Caption}"
                                       Margin="14,0,2,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="格式" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="3" Height="40">
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="格式">
                    <RadioButton x:Name="BothBtn" Tag="AudioAndVideo" Content="影片"
                                 Style="{StaticResource RadioButton.Segment}" Checked="OnModeChecked" />
                    <RadioButton x:Name="AudioBtn" Tag="AudioOnly" Content="音訊"
                                 Style="{StaticResource RadioButton.Segment}" Checked="OnModeChecked" />
                    <RadioButton x:Name="VideoBtn" Tag="VideoOnly" Content="無聲影片"
                                 Style="{StaticResource RadioButton.Segment}" Checked="OnModeChecked" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="QualityLabel" Text="畫質" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="24,0,10,0" />
            <ComboBox x:Name="QualityCombo" Width="160" Height="40" VerticalAlignment="Center"
                      AutomationProperties.Name="畫質" SelectionChanged="OnQualityChanged" />
            <!-- The rule is QualityOptions.PreferredIndex: a ceiling, the nearest lower one
                 when the video lacks it, its lowest when every one it has is higher. -->
            <TextBlock x:Name="QualityHint" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                       Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="150" />
        </StackPanel>

        <TextBlock x:Name="NoteText" Grid.Row="4" Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Button.Secondary}" MinWidth="88" IsCancel="True" />
            <Button x:Name="AddButton" Style="{StaticResource Button.Primary}" MinWidth="128" Height="36"
                    Margin="8,0,0,0" IsDefault="True" Click="OnAdd" />
        </StackPanel>
    </Grid>
</Window>
