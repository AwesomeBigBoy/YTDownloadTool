<Window x:Class="YtDlpTool.Dialogs.FilenameConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="檔案已存在" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}" FontSize="13"
        UseLayoutRounding="True">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadlineText" Grid.Row="0" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Text.Caption}">
            <Run x:Name="PathRun" />
        </TextBlock>
        <!-- v1.5.0: only for a download from a playlist or multi-link batch. -->
        <CheckBox x:Name="ForTheRestBox" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed"
                  Content="這批其他已存在的檔案也這樣處理" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Button.Secondary}" MinWidth="80"
                    IsCancel="True" Click="OnCancel" />
            <Button Content="覆蓋" Style="{StaticResource Button.Secondary}" MinWidth="80" Margin="8,0,0,0" Click="OnOverwrite" />
            <Button x:Name="RenameButton" Content="自動改名" Style="{StaticResource Button.Primary}" Height="36"
                    MinWidth="100" Margin="8,0,0,0" IsDefault="True" Click="OnRename" />
        </StackPanel>
    </Grid>
</Window>
