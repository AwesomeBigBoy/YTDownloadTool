<Window x:Class="YtDlpTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YtDlpTool.Views"
        Title="{StaticResource App.Name}"
        Icon="Resources/app.ico"
        Width="1000" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop">

    <!-- v1.5.0 layout. Native title bar (darkened by Interop.DarkTitleBar) instead of
         the hand-drawn chrome; one composer card (paste → video → options → 下載) and a
         download list that owns its own scrolling, so it can virtualize. Nothing here
         animates while idle — see the performance notes at the top of Theme.xaml. -->

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteFromClipboardCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Escape" Command="{Binding CancelSelectedQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- banners -->
            <RowDefinition Height="Auto" />  <!-- composer -->
            <RowDefinition Height="*" />     <!-- download list -->
        </Grid.RowDefinitions>

        <!-- Both banners collapse when idle, so this row is 0 px most of the time. -->
        <StackPanel Grid.Row="0">
            <views:HealthBannerView x:Name="HealthBanner" Margin="0,0,0,12" />
            <views:UpdateBannerView x:Name="UpdateBanner" Margin="0,0,0,12" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:UrlInputView x:Name="UrlInput" Grid.Column="0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE838;"
                                ToolTip="開啟下載資料夾" AutomationProperties.Name="開啟下載資料夾"
                                Click="OnOpenFolderClicked" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" Margin="2,0,0,0"
                                ToolTip="設定" AutomationProperties.Name="設定"
                                Click="OnSettingsClicked" />
                    </StackPanel>
                </Grid>

                <!-- v1.5.0: a playlist or several links being parsed and queued one by one. -->
                <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                        Background="{StaticResource Brush.SurfaceAlt}"
                        Visibility="{Binding ShowBatchStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Brush.TextSecondary}"
                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BatchStatusText" Text="{Binding BatchStatus}" TextWrapping="Wrap" />
                            <ProgressBar Height="3" Margin="0,8,0,0" Maximum="100" Value="{Binding BatchPercent, Mode=OneWay}"
                                         Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="停止" Style="{StaticResource Button.Link}" AutomationProperties.Name="停止加入"
                                    Command="{Binding StopBatchCommand}"
                                    Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                                    ToolTip="關閉" AutomationProperties.Name="關閉加入狀態"
                                    Command="{Binding DismissBatchStatusCommand}"
                                    Visibility="{Binding CanDismissBatchStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Appears once a URL has been parsed. -->
                <StackPanel x:Name="DetailsPanel"
                            Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Rectangle Height="1" Fill="{StaticResource Brush.Border}" Margin="0,16,0,16" />
                    <views:VideoCardView />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:FormatSelectorView Grid.Column="0" VerticalAlignment="Center" />
                        <views:QualityDropdown Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" />
                        <Button x:Name="AddDownloadButton" Grid.Column="3"
                                Style="{StaticResource Button.Primary}" MinWidth="128"
                                IsEnabled="{Binding CanAddDownload}"
                                AutomationProperties.Name="下載"
                                Click="OnAddDownloadClicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="AddDownloadText" Text="{StaticResource Button.AddDownload}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 更多選項 spans the row; 儲存到 sits on top of the empty right half of
                         its header line (the header toggle is left-aligned). -->
                    <Grid Margin="0,12,0,0">
                        <views:AdvancedOptionsView />
                        <views:SaveLocationView HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <views:QueuePanelView Grid.Row="2" />

        <!-- v1.5.0: shown while links are dragged over the window (static, nothing animates).
             Not hit-testable, so the drag events still reach the window underneath. -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Margin="-20,-16" Visibility="Collapsed"
              IsHitTestVisible="False" Background="#E60F1115">
            <Rectangle Margin="16" RadiusX="14" RadiusY="14" Stroke="{StaticResource Brush.Accent}"
                       StrokeThickness="2" StrokeDashArray="6 4" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE896;" Style="{StaticResource Text.Icon}" FontSize="40"
                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                <TextBlock Text="放開以加入 YouTube 網址" Style="{StaticResource Text.Title}" FontSize="18"
                           Margin="0,14,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="可一次放入多個網址、播放清單，或瀏覽器的網址捷徑" Style="{StaticResource Text.Caption}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
