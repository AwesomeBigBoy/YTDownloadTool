<Window x:Class="YtDlpTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YtDlpTool.Views"
        Title="{StaticResource App.Name}"
        Icon="Resources/app.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="14">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteFromClipboardCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Escape" Command="{Binding CancelSelectedQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <!-- Aurora animated layer behind everything -->
        <views:AuroraBackground />

        <!-- Update banner host -->
        <views:UpdateBannerView x:Name="UpdateBanner" VerticalAlignment="Top" />

        <!-- Main content -->
        <Grid Margin="{StaticResource Space.5}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- top bar -->
                <RowDefinition Height="*" />      <!-- form -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- v1.1.31: logo gradient pinned to vivid pink/orange/blue
                         regardless of theme. Previously bound to Aurora A/B/C,
                         which in dark theme are deep navy/indigo/teal — the
                         logo blended into the dark gradient header background
                         and disappeared. Pinned colours pop on both light's
                         vivid gradient and dark's deep navy. -->
                    <Ellipse Width="20" Height="20" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush>
                                <GradientStop Color="#FF5A8F" Offset="0" />
                                <GradientStop Color="#FFA940" Offset="0.5" />
                                <GradientStop Color="#40C8FF" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- v1.1.30: app name pinned to white. On both light (vivid
                         sunrise gradient) and dark (deep navy gradient) themes
                         white reads cleanly; the dark navy `Brush.TextPrimary`
                         that lit theme uses elsewhere looks dingy against the
                         saturated header gradient. -->
                    <TextBlock Text="{StaticResource App.Name}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                    <!-- v1.2.3: visible version label so bug reports can be tied to a
                         specific build. Sits inline with the app name; appears in every
                         screenshot a user sends. Populated in MainWindow.OnLoaded from
                         AssemblyInformationalVersionAttribute (set by release.yml at
                         build time from the git tag). -->
                    <TextBlock x:Name="VersionLabel"
                               FontSize="13"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center"
                               Margin="8,2,0,0"
                               Text="" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="OpenFolderButton"
                            Style="{StaticResource IconButton}"
                            Content="📁"
                            FontSize="16"
                            ToolTip="開啟下載資料夾"
                            Click="OnOpenFolderClicked" />
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource IconButton}"
                            Content="⚙"
                            FontSize="16"
                            Margin="4,0,0,0"
                            ToolTip="{StaticResource Settings.Title}"
                            Click="OnSettingsClicked" />
                </StackPanel>
            </Grid>

            <!-- Form: hosts URL input, format selector, advanced options, save location, button, queue -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel x:Name="FormHost">
                    <views:UrlInputView x:Name="UrlInput" Margin="0,0,0,16" />
                    <views:FormatSelectorView Margin="0,0,0,16" />
                    <views:QualityDropdown Margin="0,0,0,16" />
                    <views:AdvancedOptionsView Margin="0,0,0,16" />
                    <views:SaveLocationView Margin="0,0,0,16" />
                    <Button x:Name="AddDownloadButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="{StaticResource Button.AddDownload}"
                            Margin="0,0,0,16"
                            IsEnabled="{Binding CanAddDownload}"
                            Click="OnAddDownloadClicked" />
                    <views:QueuePanelView />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
